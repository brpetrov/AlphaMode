@page
@model IndexModel
@{
    Layout = "_PublicLayout";

    ViewData["Title"] = "Alpha Mode";
}


<partial name="_PromoBanner" />

<!--hero section-->
<section class="py-5 am-hero">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-12 col-md-6 text-center mx-auto">
                <div id="productGallery"
                     class="carousel slide"
                     data-bs-ride="false"
                     data-bs-interval="false"
                     data-bs-touch="true"
                     aria-label="Продуктова галерия">

                    <!-- Dots -->
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#productGallery" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Снимка 1"></button>
                        <button type="button" data-bs-target="#productGallery" data-bs-slide-to="1" aria-label="Снимка 2"></button>
                        <button type="button" data-bs-target="#productGallery" data-bs-slide-to="2" aria-label="Снимка 3"></button>
                        <button type="button" data-bs-target="#productGallery" data-bs-slide-to="3" aria-label="Снимка 4"></button>
                    </div>

                    <!-- Slides -->
                    <div class="carousel-inner">
                        <div class="carousel-item active position-relative">
                            <img src="~/images/product/1.png" class="d-block w-100" alt="Alpha Mode продуктова снимка 1" loading="lazy" decoding="async">
                        </div>

                        <div class="carousel-item position-relative">
                            <img src="~/images/product/2.jpg" class="d-block w-100" alt="Alpha Mode продуктова снимка 2" loading="lazy" decoding="async">
                            <span class="am-badge">Препоръчано от <strong>фармацевти</strong></span>
                        </div>

                        <div class="carousel-item position-relative">
                            <img src="~/images/product/3.jpg" class="d-block w-100" alt="Alpha Mode продуктова снимка 3" loading="lazy" decoding="async">
                            <span class="am-badge">Използвано от <strong>трениращи</strong></span>
                        </div>

                        <div class="carousel-item position-relative">
                            <img src="~/images/product/4.png" class="d-block w-100" alt="Alpha Mode продуктова снимка 4" loading="lazy" decoding="async">
                        </div>
                    </div>

                    <!-- Controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#productGallery" data-bs-slide="prev" aria-label="Предишна">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productGallery" data-bs-slide="next" aria-label="Следваща">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    </button>
                </div>
                <div id="heroRating" class="mt-2 text-center" hidden>
                    <a href="#reviews-summary" class="text-decoration-none d-inline-flex align-items-center gap-2 h5">
                        <span id="heroStars" class="text-warning fs-5" aria-hidden="true">★★★★★</span>
                        <span class="text-muted">
                            <span id="heroAvg">0.0</span>/5 • <span id="heroCount">0</span> отзива
                        </span>
                    </a>
                </div>
            </div>
            <div class="col-12 col-md-6 px-5">
                <div class="mx-auto mb-5">
                    <p class="mb-4 h4"><span class="fw-bolder h2">ALPHA MODE</span> – ВЛЕЗ В РЕЖИМ НА ДОМИНАЦИЯ</p>
                    <ul class="am-bullets list-unstyled mb-4">
                        <li>✔ Повишат естествения <strong>тестостерон</strong> и физическата <strong>сила</strong></li>
                        <li>✔ Подобрят <strong>енергията</strong>, <strong>издръжливостта</strong> и <strong>концентрацията</strong></li>
                        <li>✔ Подкрепят <strong>либидото</strong> и <strong>сексуалната функция</strong></li>
                        <li>✔ Намалят <strong>стреса</strong> и ускорят <strong>възстановяването</strong></li>
                    </ul>
                </div>

                <!-- Featured bundles picker -->
                @if (Model.FeaturedBundles?.Any() == true)
                {
                    <div class="mb-4" id="bundlePicker">
                        <div class="form-label fw-semibold mb-2">Избери пакет:</div>

                        @for (var i = 0; i < Model.FeaturedBundles.Count; i++)
                        {
                            var b = Model.FeaturedBundles[i];
                            <div class="form-check d-flex align-items-start gap-3 mb-2 shadow-sm">
                                <input class="form-check-input"
                                       type="radio"
                                       name="bundle"
                                       id="bundle-@b.Id"
                                       value="@b.Id"
                                       @(i == 0 ? "checked" : null) />
                                <label class="form-check-label d-flex justify-content-between w-100 cursor-pointer" for="bundle-@b.Id">
                                    <span>@b.Name (@b.Size бр.)</span>
                                    <span class="fw-semibold">@b.Price.ToString("0.00") лв.</span>
                                </label>
                            </div>
                        }
                    </div>
                }

                <!-- CTA -->
                <div class="mt-5 text-center">
                    <a id="orderCta" class="btn btn-dark btn-lg rounded-pill mt-4 px-5 py-3" asp-page="/Order">Поръчай сега</a>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_ImageCarousel" />

