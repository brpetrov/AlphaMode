                <div class="col-auto am-col-brand">
                    <i class="bi bi-check2-circle text-success fs-5"></i>
                </div>
                <div class="col-auto am-col-other">
                    <i class="bi bi-x-lg text-secondary fs-6"></i>
                </div>
            </div>

            <!-- Row 3 -->
            <div class="row g-0 align-items-center flex-nowrap border-top px-3 py-3">
