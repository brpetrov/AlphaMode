@page
@model IndexModel
@{
    Layout = "_PublicLayout";

    ViewData["Title"] = "Home page";
}


<div class="am-ticker" role="region" aria-label="Alpha Mode предимства">
    <div class="am-ticker__track">
        <div class="am-ticker__row">
            <!-- A -->
            <ul class="am-ticker__seq">
                <li>🌿 <strong>Натурална формула</strong> — без синтетични стимуланти</li>
                <li>📈 <strong>Подкрепя естествения тестостерон</strong></li>
                <li>⚡ <strong>Енергия и издръжливост</strong> през целия ден</li>
                <li>🧠 <strong>По-добър фокус</strong> и концентрация</li>
                <li>🔥 <strong>Подкрепя либидото</strong> и сексуалната функция</li>
                <li>⏱️ <strong>По-бързо възстановяване</strong> след тренировка</li>
                <li>🛡️ <strong>Повишава жизнеността</strong> и тонуса</li>
                <li>🇧🇬 <strong>Произведено в България</strong></li>
                <li>🚚 <strong>Бърза доставка</strong> до врата</li>
                <li>✅ <strong>Гаранция „Без риск“</strong></li>
            </ul>
            <!-- B (identical copy; required for seamless loop) -->
            <ul class="am-ticker__seq" aria-hidden="true">
                <li>🌿 <strong>Натурална формула</strong> — без синтетични стимуланти</li>
                <li>📈 <strong>Подкрепя естествения тестостерон</strong></li>
                <li>⚡ <strong>Енергия и издръжливост</strong> през целия ден</li>
                <li>🧠 <strong>По-добър фокус</strong> и концентрация</li>
                <li>🔥 <strong>Подкрепя либидото</strong> и сексуалната функция</li>
                <li>⏱️ <strong>По-бързо възстановяване</strong> след тренировка</li>
                <li>🛡️ <strong>Повишава жизнеността</strong> и тонуса</li>
                <li>🇧🇬 <strong>Произведено в България</strong></li>
                <li>🚚 <strong>Бърза доставка</strong> до врата</li>
                <li>✅ <strong>Гаранция „Без риск“</strong></li>
            </ul>
        </div>
    </div>
</div>

<!-- One hero section: image + text bullets-->
<section class="py-5 am-hero">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-12 col-md-6 text-center mx-auto">
                <div>
                    <img src="~/images/alpha_mode_bottle.png" class="w-50 mx-auto d-block" />
                </div>
                <div id="heroRating" class="mt-2 text-center" hidden>
                    <a href="#reviews-summary" class="text-decoration-none d-inline-flex align-items-center gap-2 h5">
                        <span id="heroStars" class="text-warning fs-5" aria-hidden="true">★★★★★</span>
                        <span class="text-muted">
                            <span id="heroAvg">0.0</span>/5 • <span id="heroCount">0</span> отзива
                        </span>
                    </a>
                </div>
            </div>
            <div class="col-12 col-md-6 px-5">
                <div class="mx-auto mb-5">
                    <p class="mb-4 h4"><span class="fw-bolder h2">ALPHA MODE</span> – ВЛЕЗ В РЕЖИМ НА ДОМИНАЦЯ</p>
                    <ul class="am-bullets list-unstyled mb-4">
                        <li>✔ Повишат естествения <strong>тестостерон</strong> и физическата <strong>сила</strong></li>
                        <li>✔ Подобрят <strong>енергията</strong>, <strong>издръжливостта</strong> и <strong>концентрацията</strong></li>
                        <li>✔ Подкрепят <strong>либидото</strong> и <strong>сексуалната функция</strong></li>
                        <li>✔ Намалят <strong>стреса</strong> и ускорят <strong>възстановяването</strong></li>
                    </ul>
                </div>

                <!-- Featured bundles picker -->
                @if (Model.FeaturedBundles?.Any() == true)
                {
                    <div class="mb-4" id="bundlePicker">
                        <div class="form-label fw-semibold mb-2">Избери пакет:</div>

                        @for (var i = 0; i < Model.FeaturedBundles.Count; i++)
                        {
                            var b = Model.FeaturedBundles[i];
                            <div class="form-check d-flex align-items-start gap-3 mb-2 shadow-sm">
                                <input class="form-check-input"
                                       type="radio"
                                       name="bundle"
                                       id="bundle-@b.Id"
                                       value="@b.Id"
                                       @(i == 0 ? "checked" : null) />
                                <label class="form-check-label d-flex justify-content-between w-100 cursor-pointer" for="bundle-@b.Id">
                                    <span>@b.Name (@b.Size бр.)</span>
                                    <span class="fw-semibold">@b.Price.ToString("0.00") лв.</span>
                                </label>
                            </div>
                        }
                    </div>
                }

                <!-- CTA -->
                <div class="mt-5 text-center">
                    <a id="orderCta" class="btn btn-dark btn-lg rounded-pill px-5" asp-page="/Order">Поръчай сега</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Product intro section (below hero CTA) -->
<section class="py-4 py-md-5 border-top">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-dark rounded-pill me-2">Alpha Mode</span>
                        <h2 class="h4 fw-bold mb-0">Повече енергия. Повече фокус.</h2>
                    </div>

                    <p class="lead mb-4">
                        Българска натурална добавка, създадена за мъже, които искат да възстановят енергията, силата, фокуса и сексуалната си функция.
                    </p>

                    <p class="lead mb-0">
                        Формулата съчетава бабини зъби, боров прашец, ашваганда, женшен, цинк, витамин B6 и пиперин
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="my-5 fw-bold">Защо да избереш Alpha Mode?</h2>
        <div class="row g-4 justify-content-evenly">
            <div class="col-md-3">
                <div class="p-4 h-100 border rounded shadow-sm bg-white">
                    <div class="display-6 mb-3"><img src="~/images/bulgaria_flag.png" style="width:45px" /></div>
                    <h5 class="fw-bold">Българско производство</h5>
                    <p class="mb-0 small text-muted">Гарантирано качество, доверие в произхода.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 h-100 border rounded shadow-sm bg-white">
                    <div class="display-6 mb-3">🌱</div>
                    <h5 class="fw-bold">Натурална формула</h5>
                    <p class="mb-0 small text-muted">Без синтетични стимуланти – само природни съставки.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 h-100 border rounded shadow-sm bg-white">
                    <div class="display-6 mb-3">🔥</div>
                    <h5 class="fw-bold">Реални резултати</h5>
                    <p class="mb-0 small text-muted">За мъже, които искат да действат и да водят.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 h-100 border rounded shadow-sm bg-white">
                    <div class="display-6 mb-3">🚀</div>
                    <h5 class="fw-bold">Създай мотивация</h5>
                    <p class="mb-0 small text-muted">Не чакай мотивация – създай я сам. Включи Alpha Mode.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 text-center">
    <div class="container">
        <h2 class="fw-bold my-5">Готови ли сте за промяна?</h2>
        <p class="mb-4 lead text-muted">
        <p class="lead mt-3">Включи Alpha Mode. Стани версията на себе си, която командва!</p>
        </p>
        <a class="btn btn-dark btn-lg rounded-pill mt-4 px-5" asp-page="/Order">Опитай Сега</a>
        <p class="text-sm text-muted mt-2">Без Риск</p>
    </div>
</section>

<section id="reviews-summary" class="py-5 bg-white">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">
            <i class="bi bi-chat-heart-fill me-2"></i> Отзиви на клиенти
        </h2>
        <div class="row text-center align-items-center gx-4">
            <!-- average left -->
            <div class="col-md-4 mb-4 mb-md-0" id="avgBlock"></div>

            <!-- histogram middle -->
            <div class="col-md-4" id="histogramBlock"></div>

            <!-- button right -->
            <div class="col-md-4 d-grid">
                <div>
                    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        Напишете отзив
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" id="reviewForm">
            <div class="modal-header">
                <h5 class="modal-title">Нов отзив</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Име</label>
                    <input name="name" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input name="email" type="email" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Отзив</label>
                    <textarea name="text" rows="4" class="form-control" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label d-block" for="ratingSelect">Оценка</label>

                    <div class="d-flex  align-items-start gap-2">
                        <select id="ratingSelect" name="rating" class="form-select w-auto" required>
                            <option value="" disabled selected>Изберете оценка</option>
                            <option value="5">5</option>
                            <option value="4">4 </option>
                            <option value="3">3</option>
                            <option value="2">2</option>
                            <option value="1">1</option>
                        </select>

                    </div>
                    <div id="ratingPreview" class="text-dark h4 my-3" aria-hidden="true"></div>
           
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Отказ</button>
                <button class="btn btn-danger" type="submit">Изпрати</button>
            </div>
        </form>

        <div id="thankYouMsg" class="modal-content text-center d-none py-5">
            <div class="modal-body">
                <div class="display-5 mb-3 text-dark">Благодарим!</div>
                <p class="lead mb-0">Вашият отзив беше изпратен успешно.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button class="btn btn-outline-dark" data-bs-dismiss="modal">Затвори</button>
            </div>
        </div>
    </div>
</div>

<!-- ★ Reviews Section -->
<section id="reviews" class="py-5 bg-light border-top">
    <div class="container">
      
        <!-- Reviews grid -->
        <div id="reviewsContainer" class="row g-4"></div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul id="reviewsPager" class="pagination justify-content-center"></ul>
        </nav>
    </div>
</section>


<script>
    (function () {
      const cta = document.getElementById('orderCta');
      if (!cta) return;

      function selectedBundleId() {
        const r = document.querySelector('input[name="bundle"]:checked');
        return r ? r.value : null;
      }

      function updateCta() {
        const id = selectedBundleId();
        const baseHref = cta.getAttribute('href') || cta.dataset.href || cta.href;
        if (!baseHref) return;

        const url = new URL(baseHref, window.location.origin);
        if (id) url.searchParams.set('bundleId', id);
        else url.searchParams.delete('bundleId');

        // Prefer setting href attribute (works for asp-page generated anchors too)
        cta.setAttribute('href', url.pathname + url.search + url.hash);
      }

      // initial + on change
      updateCta();
      document.addEventListener('change', (e) => {
        if (e.target && e.target.name === 'bundle') updateCta();
      });
    })();
</script>