@page
@model IndexModel
@{
    Layout = "_PublicLayout";

    ViewData["Title"] = "Home page";
}

<!-- One hero section: image + text bullets (can be replaced by page content if you want) -->
<section class="py-5 am-hero">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-12 col-md-6 text-center mx-auto">
                <!-- Replace with your product image: /img/bottle.png -->
                <div>
                    <img src="~/images/alphamodebottle.png" class="w-50 mx-auto d-block" />
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="mx-auto mb-5">
                    <h1 class="mb-5">Енергия, фокус и спокойствие</h1>
                    <p class="lead mb-4">
                        Добавка с екстракт от ашваганда и витамини за ежедневен тонус.
                    </p>
                    <ul class="am-bullets list-unstyled">
                        <li>✔ Подкрепя <strong>концентрацията</strong> и яснотата на мисълта</li>
                        <li>✔ Помага за <strong>намаляване на стреса</strong> и напрежението</li>
                        <li>✔ Подпомага <strong>възстановяването</strong> и качеството на съня</li>
                        <li>✔ Подходящо за натоварени дни и тренировки</li>
                    </ul>
                </div>
              

                <!-- Example CTA -->
                <div class="mt-5 text-center">
                    <a class="btn btn-dark btn-lg rounded-pill px-5" asp-page="/Order">Поръчай сега</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="my-5 fw-bold">Защо AlphaMode?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 h-100">
                    <div class="display-6 mb-3">⚡</div>
                    <h5 class="fw-bold">Повече енергия</h5>
                    <p class="mb-0 small text-muted">Подкрепа през целия ден – за работа, учене и тренировки.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 h-100">
                    <div class="display-6 mb-3">🧘</div>
                    <h5 class="fw-bold">По-малко стрес</h5>
                    <p class="mb-0 small text-muted">Адаптоген, който помага на тялото да се справи с напрежението.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 h-100">
                    <div class="display-6 mb-3">🌙</div>
                    <h5 class="fw-bold">По-добър сън</h5>
                    <p class="mb-0 small text-muted">Подпомага качествената почивка и възстановяване след активен ден.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 text-center">
    <div class="container">
        <h2 class="fw-bold my-5">Готови ли сте за промяна?</h2>
        <p class="mb-4 lead text-muted">
            Изпробвайте AlphaMode днес и усетете разликата. <br />
            Ако не сте доволни – предлагаме 30-дневна гаранция за връщане.
        </p>
        <a class="btn btn-dark btn-lg rounded-pill my-5 px-5" asp-page="/Order">Опитай Без Риск</a>
    </div>
</section>

<section id="reviews-summary" class="py-5 bg-white">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">
            <i class="bi bi-chat-heart-fill me-2"></i> Отзиви на клиенти
        </h2>
        <div class="row text-center align-items-center gx-4">
            <!-- average left -->
            <div class="col-md-4 mb-4 mb-md-0" id="avgBlock"></div>

            <!-- histogram middle -->
            <div class="col-md-4" id="histogramBlock"></div>

            <!-- button right -->
            <div class="col-md-4 d-grid">
                <div>
                    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        Напишете отзив
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" id="reviewForm">
            <div class="modal-header">
                <h5 class="modal-title">Нов отзив</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Име</label>
                    <input name="name" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input name="email" type="email" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Отзив</label>
                    <textarea name="text" rows="4" class="form-control" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label d-block" for="ratingSelect">Оценка</label>

                    <div class="d-flex  align-items-start gap-2">
                        <select id="ratingSelect" name="rating" class="form-select w-auto" required>
                            <option value="" disabled selected>Изберете оценка</option>
                            <option value="5">5</option>
                            <option value="4">4 </option>
                            <option value="3">3</option>
                            <option value="2">2</option>
                            <option value="1">1</option>
                        </select>

                    </div>
                    <div id="ratingPreview" class="text-dark h4 my-3" aria-hidden="true"></div>
           
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Отказ</button>
                <button class="btn btn-danger" type="submit">Изпрати</button>
            </div>
        </form>

        <div id="thankYouMsg" class="modal-content text-center d-none py-5">
            <div class="modal-body">
                <div class="display-5 mb-3 text-dark">Благодарим!</div>
                <p class="lead mb-0">Вашият отзив беше изпратен успешно.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button class="btn btn-outline-dark" data-bs-dismiss="modal">Затвори</button>
            </div>
        </div>
    </div>
</div>

<!-- ★ Reviews Section -->
<section id="reviews" class="py-5 bg-light border-top">
    <div class="container">
      
        <!-- Reviews grid -->
        <div id="reviewsContainer" class="row g-4"></div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul id="reviewsPager" class="pagination justify-content-center"></ul>
        </nav>
    </div>
</section>