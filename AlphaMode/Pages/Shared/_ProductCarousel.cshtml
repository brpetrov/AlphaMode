<div id="productGallery"
     class="carousel slide"
     data-bs-ride="false"
     aria-label="Продуктова галерия">
    <div class="carousel-inner">
        <div class="carousel-item active position-relative">
            <img src="~/images/product/1.png" class="d-block w-100" alt="Alpha Mode продуктова снимка 1" loading="lazy">
        </div>
        <div class="carousel-item position-relative">
            <img src="~/images/product/2.jpg" class="d-block w-100" alt="Alpha Mode продуктова снимка 2" loading="lazy">
            <span class="am-badge position-absolute bottom-0 start-0 m-2 px-2 py-1 bg-dark bg-opacity-75 text-white small rounded-2">Препоръчано от <strong>фармацевти</strong></span>
        </div>
        <div class="carousel-item position-relative">
            <img src="~/images/product/3.jpg" class="d-block w-100" alt="Alpha Mode продуктова снимка 3" loading="lazy">
            <span class="am-badge position-absolute bottom-0 start-0 m-2 px-2 py-1 bg-dark bg-opacity-75 text-white small rounded-2">Използвано от <strong>трениращи</strong></span>
        </div>
        <div class="carousel-item position-relative">
            <img src="~/images/product/4.png" class="d-block w-100" alt="Alpha Mode продуктова снимка 4" loading="lazy">
        </div>
        <div class="carousel-item position-relative">
            <img src="~/images/product/label.png" class="d-block w-100" alt="Alpha Mode продуктова снимка 5" loading="lazy">
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#productGallery" data-bs-slide="prev" aria-label="Предишна">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#productGallery" data-bs-slide="next" aria-label="Следваща">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

<!-- Thumbnails (swipe by native horizontal scroll) -->
<div id="productThumbs" class="am-thumbs d-flex gap-2 mt-2 overflow-auto py-2">
    <button type="button" class="am-thumb active" data-index="0"><img src="~/images/product/1.png" alt=""></button>
    <button type="button" class="am-thumb" data-index="1"><img src="~/images/product/2.jpg" alt=""></button>
    <button type="button" class="am-thumb" data-index="2"><img src="~/images/product/3.jpg" alt=""></button>
    <button type="button" class="am-thumb" data-index="3"><img src="~/images/product/4.png" alt=""></button>
    <button type="button" class="am-thumb" data-index="4"><img src="~/images/product/label.png" alt=""></button>
</div>

<style>
    /* minimal, component-scoped */
    #productThumbs {
        -webkit-overflow-scrolling: touch;
    }

        #productThumbs .am-thumb {
            border: 0;
            padding: 0;
            background: transparent;
            flex: 0 0 auto;
        }

            #productThumbs .am-thumb img {
                width: 86px;
                height: 86px;
                object-fit: cover;
                border-radius: .5rem;
                opacity: .65;
                display: block;
            }

            #productThumbs .am-thumb.active img {
                outline: 2px solid #111;
                opacity: 1;
            }
    /* prevent review badges from blocking swipe */
    #productGallery .am-badge {
        pointer-events: none;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.bootstrap) return;

      // 1) Ensure mobile swipe is enabled explicitly
      const galleryEl = document.getElementById('productGallery');
      const gallery   = new bootstrap.Carousel(galleryEl, { interval: false, touch: true, ride: false, wrap: true });

      // 2) Thumbnails -> slide
      const thumbsWrap = document.getElementById('productThumbs');
      const thumbs = Array.from(thumbsWrap.querySelectorAll('.am-thumb'));
      thumbs.forEach(btn => {
        btn.addEventListener('click', () => {
          const i = +btn.dataset.index;
          gallery.to(i);
        }, { passive:true });
      });

      // 3) Sync active thumb on slide
      galleryEl.addEventListener('slid.bs.carousel', (e) => {
        const i = e.to;
        thumbs.forEach(t => t.classList.toggle('active', +t.dataset.index === i));
        // auto-scroll thumbs so active stays in view
        const active = thumbs[i];
        if (active) {
          const r = active.getBoundingClientRect();
          const pr = thumbsWrap.getBoundingClientRect();
          if (r.left < pr.left || r.right > pr.right) {
            thumbsWrap.scrollTo({ left: active.offsetLeft - pr.width/2 + r.width/2, behavior: 'smooth' });
          }
        }
      }, { passive:true });
    });
</script>