<section class="py-4 am-carousel">
    <div class="container">
        <div class="row">
            <!-- Wider on desktop but still centered -->
            <div class="col-12 col-lg-11 col-xl-10 mx-auto p-3">
                <div id="amGallery"
                     class="carousel slide shadow-sm"
                     data-bs-ride="carousel"
                     data-bs-interval="5000"
                     data-bs-touch="true"
                     data-bs-pause="hover"
                     aria-label="Галерия">

                    <!-- Indicators (6 slides) -->
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#amGallery" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Снимка 1"></button>
                        <button type="button" data-bs-target="#amGallery" data-bs-slide-to="1" aria-label="Снимка 2"></button>
                        <button type="button" data-bs-target="#amGallery" data-bs-slide-to="2" aria-label="Снимка 3"></button>
                        <button type="button" data-bs-target="#amGallery" data-bs-slide-to="3" aria-label="Снимка 4"></button>
                        <button type="button" data-bs-target="#amGallery" data-bs-slide-to="4" aria-label="Снимка 5"></button>
                        <button type="button" data-bs-target="#amGallery" data-bs-slide-to="5" aria-label="Снимка 6"></button>
                    </div>

                    <div class="carousel-inner">
                        <div class="carousel-item active" data-bs-interval="5000">
                            <img src="~/images/carousel/1.jpg" class="d-block w-100 am-slide-img" alt="Alpha Mode — енергия и фокус" loading="lazy" />
                            <div class="carousel-caption am-caption">
                                <h5 class="fw-bold mb-1">Натурална формула</h5>
                                <p class="mb-3">Бабини зъби, ашваганда, женшен, цинк и B6.</p>
                            </div>
                        </div>

                        <div class="carousel-item" data-bs-interval="5000">
                            <img src="~/images/carousel/2.jpg" class="d-block w-100 am-slide-img" alt="Alpha Mode — издръжливост и тонус" loading="lazy" />
                            <div class="carousel-caption am-caption">
                                <h5 class="fw-bold mb-1">Издръжливост</h5>
                                <p class="mb-3">Подкрепа за тренировките и динамичния ден.</p>
                            </div>
                        </div>

                        <div class="carousel-item" data-bs-interval="5000">
                            <img src="~/images/carousel/3.jpg" class="d-block w-100 am-slide-img" alt="Alpha Mode — естествена подкрепа" loading="lazy" />
                            <div class="carousel-caption am-caption">
                                <h5 class="fw-bold mb-1">Повече енергия</h5>
                                <p class="mb-3">Включи Alpha Mode. Бъди в своя пик.</p>
                            </div>
                        </div>

                        <div class="carousel-item" data-bs-interval="5000">
                            <img src="~/images/carousel/4.jpg" class="d-block w-100 am-slide-img" alt="Alpha Mode — фокус и концентрация" loading="lazy" />
                            <div class="carousel-caption am-caption">
                                <h5 class="fw-bold mb-1">Фокус и контрол</h5>
                                <p class="mb-3">Подкрепя концентрация и ментална устойчивост.</p>
                            </div>
                        </div>

                        <div class="carousel-item" data-bs-interval="5000">
                            <img src="~/images/carousel/5.jpg" class="d-block w-100 am-slide-img" alt="Alpha Mode — възстановяване" loading="lazy" />
                            <div class="carousel-caption am-caption">
                                <h5 class="fw-bold mb-1">По-бързо възстановяване</h5>
                                <p class="mb-3">Готов за следващото предизвикателство.</p>
                            </div>
                        </div>

                        <div class="carousel-item" data-bs-interval="5000">
                            <img src="~/images/carousel/6.jpg" class="d-block w-100 am-slide-img" alt="Alpha Mode — увереност" loading="lazy" />
                            <div class="carousel-caption am-caption">
                                <h5 class="fw-bold mb-1">Увереност</h5>
                                <p class="mb-3">Влез в режим на доминация.</p>
                            </div>
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#amGallery" data-bs-slide="prev" aria-label="Предишна">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#amGallery" data-bs-slide="next" aria-label="Следваща">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>