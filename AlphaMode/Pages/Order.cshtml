@page
@model AlphaMode.Pages.OrderPageModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Поръчка";
}

<section class="py-5">
    <div class="container" style="max-width: 820px;">
        <h1 class="mb-4 text-center">Поръчка</h1>

        @* <partial name="_ValidationSummary" /> *@

        <form method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Order.FullName" class="form-label"></label>
                    <input asp-for="Order.FullName" class="form-control" />
                    <span asp-validation-for="Order.FullName" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Order.Address" class="form-label"></label>
                    <input asp-for="Order.Address" class="form-control" />
                    <span asp-validation-for="Order.Address" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Order.Telephone" class="form-label"></label>
                    <input asp-for="Order.Telephone" class="form-control" />
                    <span asp-validation-for="Order.Telephone" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Order.DateOfBirth" class="form-label"></label>
                    <input asp-for="Order.DateOfBirth" class="form-control" />
                    <span asp-validation-for="Order.DateOfBirth" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Order.Quantity" class="form-label"></label>
                    <input asp-for="Order.Quantity" type="number" class="form-control" />
                    <span asp-validation-for="Order.Quantity" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Order.PromoCode" class="form-label"></label>
                    <input asp-for="Order.PromoCode" class="form-control" />
                    <span asp-validation-for="Order.PromoCode" class="text-danger"></span>
                </div>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-dark btn-lg rounded-pill px-5">Потвърди поръчката</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
