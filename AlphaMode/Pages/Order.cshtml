@page
@model AlphaMode.Pages.OrderPageModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Alpha Mode Поръчка";
}

<section class="py-5">
    <div class="container" style="max-width: 820px;">
        <h1 class="mb-4 text-center">Поръчка</h1>

        <form method="post">
            <!-- Validation summary -->
            <div class="text-danger mb-3">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
            <span asp-validation-for="AcceptsCodPolicy" class="text-danger my-3"></span>

            <input type="hidden" id="promoPercentServer" value="@Model.PromoPercent" />


            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Order.FullName" class="form-label"></label>
                    <input asp-for="Order.FullName" class="form-control" />
                    <span asp-validation-for="Order.FullName" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Order.DeliveryMethod" class="form-label"></label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   asp-for="Order.DeliveryMethod"
                                   id="dmHome"
                                   value="HomeAddress" />
                            <label class="form-check-label" for="dmHome">Адрес</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   asp-for="Order.DeliveryMethod"
                                   id="dmEcont"
                                   value="EcontOffice" />
                            <label class="form-check-label" for="dmEcont">Еконт Офис или Еконтомат</label>
                        </div>
                    </div>
                    <span asp-validation-for="Order.DeliveryMethod" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Order.Address" class="form-label" id="addressLabel"></label>
                    <input asp-for="Order.Address" class="form-control" id="addressInput" />
                    <span asp-validation-for="Order.Address" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Order.Town" class="form-label"></label>
                    <input asp-for="Order.Town" class="form-control" />
                    <span asp-validation-for="Order.Town" class="text-danger"></span>
                </div>

                @* TRAP FIELD FOR BOTS *@
                <div class="col-12 d-none">
                    <label class="form-label" for="trapField">Оставете празно</label>
                    <input id="trapField" asp-for="TrapField" class="form-control" autocomplete="off" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Order.Telephone" class="form-label"></label>
                    <input asp-for="Order.Telephone" class="form-control" />
                    <span asp-validation-for="Order.Telephone" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Order.EmailAddress" class="form-label"></label>
                    <input asp-for="Order.EmailAddress" class="form-control" />
                    <span asp-validation-for="Order.EmailAddress" class="text-danger"></span>
                </div>

                @* <div class="col-md-6">
                    <label asp-for="Order.DateOfBirth" class="form-label"></label>
                    <input asp-for="Order.DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="Order.DateOfBirth" class="text-danger"></span>
                </div> *@

                <div class="col-md-6">
                    <label asp-for="Order.BundleId" class="form-label">Количество</label>
                    <select asp-for="Order.BundleId" class="form-select" required id="bundleSelect">
                        <option value="">Изберете пакет...</option>
                        @foreach (var b in Model.Bundles)
                        {
                            <option value="@b.Id"
                                    data-price="@b.Price"
                                    selected="@(Model.Order.BundleId == b.Id ? "selected" : null)">
                                @b.Name (@b.Size бр.) – @b.Price лв.
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Order.BundleId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Order.PromoCode" class="form-label"></label>
                    <input asp-for="Order.PromoCode"
                           class="form-control"
                           id="promoInput"
                           data-promo-url="@Url.Page("/Order", null, new { handler = "Promo" }, null)" />
                    <div id="promoFeedback" class="form-text"></div>
                    <span asp-validation-for="Order.PromoCode" class="text-danger"></span>
                </div>
            </div>

            <!-- Price summary -->
            <div class="mt-4 p-3 border rounded bg-light">
                <div class="d-flex justify-content-between">
                    <span>Цена на пакет:</span>
                    <strong><span id="basePrice">0.00</span> лв</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Отстъпка (<span id="discountPercent">0</span>%)</span>
                    <strong>- <span id="discountAmount">0.00</span> лв</strong>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between fs-5">
                    <span>Крайна цена:</span>
                    <strong><span id="finalTotal">0.00</span> лв</strong>
                </div>
            </div>

            <div class="mt-4">
                <div class="form-check text-start">
                    <input class="form-check-input"
                           asp-for="AcceptsCodPolicy"
                           id="codPolicy" />
                    <label class="form-check-label" for="codPolicy">
                        Потвърждавам, че ще получа пратката в срок след пристигането ѝ
                        в офис/на адрес.
                    </label>
                </div>
                <span asp-validation-for="AcceptsCodPolicy" class="text-danger my-4"></span>
            </div>

            <div class="text-center mt-4">
                <button id="submitOrderBtn" type="submit" class="btn btn-dark btn-lg rounded-pill px-5">
                    Потвърди поръчката
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/order.js" asp-append-version="true"></script>
}