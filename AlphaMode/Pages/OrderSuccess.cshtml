@page
@using AlphaMode.Models
@model AlphaMode.Pages.OrderSuccessModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Благодарим!";
}

<section class="py-5">
    <div class="container" style="max-width: 900px;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success"
                 style="width:90px;height:90px;">
                <i class="bi bi-check2-circle" style="font-size:2rem;"></i>
            </div>
            <h1 class="mt-3 mb-1">Благодарим за поръчката!</h1>
        </div>

        @if (Model.View == null)
        {
            <div class="alert alert-success mt-4" role="alert">
                Поръчката е изпратена успешно. Ако имате въпроси, свържете се с нас.
            </div>
            <div class="text-center mt-3">
                <a class="btn btn-outline-dark" asp-page="/Index"><i class="bi bi-house"></i> Към началото</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Left: Order summary -->
                <div class="col-12 col-lg-7">
                    <div class="border rounded-3 p-3 p-md-4">
                        <h2 class="h5 mb-3">Обобщение на поръчката</h2>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <tbody>
                                    <tr><td class="text-muted" style="width: 220px;">Клиент</td><td>@Model.View.FullName</td></tr>
                                    <tr><td class="text-muted">Телефон</td><td>@Model.View.Telephone</td></tr>
                                    <tr>
                                        <td class="text-muted">@Model.View.DeliveryLabel</td>
                                        <td><i class="bi bi-check"></i></td>
                                    </tr>
                                    <tr><td class="text-muted">Адрес за доставка</td><td>@Model.View.Address</td></tr>
                                    <tr><td class="text-muted">Пакет</td><td>@Model.View.BundleName</td></tr>
                                    <tr><td class="text-muted">Цена (база)</td><td>@Model.View.BasePrice.ToString("0.00") лв</td></tr>
                                    @if (Model.View.DiscountPercent > 0)
                                    {
                                        <tr>
                                            <td class="text-success fw-semibold">Отстъпка (@Model.View.DiscountPercent%)</td>
                                            <td class="text-success fw-semibold">- @Model.View.DiscountAmount.ToString("0.00") лв</td>
                                        </tr>
                                    }
                                    <tr class="table-light">
                                        <td class="fw-bold">Крайна цена</td>
                                        <td class="fw-bold">@Model.View.FinalTotal.ToString("0.00") лв</td>
                                    </tr>
                                    <tr><td class="text-muted">Промо код</td><td>@(string.IsNullOrWhiteSpace(Model.View.PromoCode) ? "-" : Model.View.PromoCode)</td></tr>
                                    <tr><td class="text-muted">Дата и час</td><td>@Model.View.CreatedLocal.ToString("dd.MM.yyyy HH:mm")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Right: Delivery & actions -->
                <div class="col-12 col-lg-5">
                    <div class="border rounded-3 p-3 p-md-4 h-100">
                        <h2 class="h5 mb-3">Доставка и плащане</h2>
                        <ul class="list-unstyled mb-3">
                            <li class="mb-2"><i class="bi bi-truck"></i> Доставка: <strong>Еконт</strong> (1–3 работни дни)</li>
                            <li class="mb-2"><i class="bi bi-cash-coin"></i> Плащане: <strong>Наложен платеж</strong> при получаване</li>
                            <li class="mb-2"><i class="bi bi-info-circle"></i> Ще се свържем с вас за потвърждение.</li>
                        </ul>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button class="btn btn-outline-dark" onclick="window.print()"><i class="bi bi-printer"></i> Принт</button>
                           
                            <a class="btn btn-outline-primary" asp-page="/Index"><i class="bi bi-house"></i> Към началото</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-5">
                <div class="border rounded-3 p-3">
                    <h3 class="h6 mb-2 text-warning">
                        <i class="bi bi-exclamation-triangle"></i> Важно за пратката
                    </h3>
                    <ul class="mb-2">
                        <li>
                            Ще получите SMS от <strong>Еконт</strong>, когато пратката пристигне
                            в офис/при куриера.
                        </li>

                        @if (Model.View.DeliveryMethod == DeliveryMethod.EcontOffice)
                        {
                            <li>
                                Пратката се пази в офиса на Еконт само няколко дни, след което автоматично
                                се връща към нас.
                            </li>
                        }
                        else
                        {
                            <li>
                                Курирът ще опита да се свърже с вас на посочения телефон за доставка
                                до адрес.
                            </li>
                        }

                        <li>
                            Всяка върната пратка ни струва доставка в двете посоки. При многократно
                            неполучени пратки можем да ограничим бъдещи поръчки с наложен платеж.
                        </li>
                    </ul>

                    <p class="mb-0 px-3">
                        Ако сте поръчали по грешка или искате промяна, моля свържете се с нас
                        възможно най-бързо на <a href="tel:+359879566880.">+359 879 566 880</a>
                        или <a href="mailto:alphamodebusiness@gmail.com">alphamodebusiness@gmail.com</a>
                    </p>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    @* Fire Purchase only when we actually have order data *@
    @if (Model.View != null)
    {
        <script>
            (function () {
                var value = Number('@Model.View.FinalTotal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
                if (!isFinite(value)) value = 0;

                if (window.fbq) {
                    fbq('track', 'Purchase', {
                        value: value,
                        currency: 'BGN'
                    });
                }
            })();
        </script>
    }
}
