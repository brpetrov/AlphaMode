@page
@model AlphaMode.Pages.Admin.BundlesModel
@{
    ViewData["Title"] = "Пакети";
}

<h1 class="mb-4 fw-semibold"><i class="bi bi-box2-heart"></i> Пакети (Bundles)</h1>

<partial name="_ValidationSummary" />

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" asp-page="/Admin/BundleDetail">
        <i class="bi bi-plus-circle"></i> Нов пакет
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light text-nowrap text-center">
            <tr>
                <th class="text-start">Име</th>
                <th>Брой</th>
                <th>Цена (лв.)</th>
                <th>Активен?</th>
                <th>Начална страница?</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Bundles)
            {
                <tr class="text-center">
                    <td class="fw-semibold text-start">
                        <a asp-page="/Admin/BundleDetail" asp-route-id="@b.Id">
                            @b.Name
                        </a>
                    </td>

                    <td>@b.Size</td>
                    <td>@b.Price.ToString("0.00")</td>

                    <td>
                        @if (b.IsActive)
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill"></i></span>
                        }
                        else
                        {
                            <span class="text-danger"><i class="bi bi-x-circle-fill"></i></span>
                        }
                    </td>

                    <!-- NEW: FrontDisplay cell -->
                    <td>
                        @if (b.FrontDisplay)
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill"></i></span>
                        }
                        else
                        {
                            <span class="text-danger"><i class="bi bi-x-circle-fill"></i></span>
                        }
                    </td>

                    <!-- NEW: Actions (Delete with confirm modal) -->
                    <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDelete-@b.Id">
                            <i class="bi bi-trash"></i> Изтрий
                        </button>

                        <!-- Confirm Delete Modal (unique per row) -->
                        <div class="modal fade" id="confirmDelete-@b.Id" tabindex="-1" aria-labelledby="confirmDeleteLabel-@b.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <form method="post" asp-page-handler="Delete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="deleteId" value="@b.Id" />

                                        <div class="modal-header">
                                            <h5 class="modal-title" id="confirmDeleteLabel-@b.Id">
                                                Потвърждение за изтриване
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Затвори"></button>
                                        </div>

                                        <div class="modal-body text-start">
                                            Наистина ли искате да изтриете пакета:
                                            <strong>@b.Name</strong>?
                                        </div>

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отказ</button>
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bi bi-trash"></i> Изтрий
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
