@page
@model AlphaMode.Pages.Admin.OrderDetailModel
@using AlphaMode.Helpers
@using AlphaMode.Models
@{
    ViewData["Title"] = "Поръчка #" + Model.Form.Id;
}

<h1 class="mb-4 fw-semibold">
    <i class="bi bi-receipt"></i> Поръчка <span class="text-muted">#@Model.Form.Id</span>
</h1>

@if (TempData["Success"] is string ok && !string.IsNullOrEmpty(ok))
{
    <div class="alert alert-success">@ok</div>
}
@if (!ViewContext.ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">Моля, коригирайте грешките и опитайте отново.</div>
}

<div class="row g-4">
    <!-- Read-only summary -->
    <div class="col-12 col-lg-7">
        <div class="border rounded-3 p-3 p-md-4">
            <h2 class="h5 mb-3">Данни за клиента</h2>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <tbody>
                        <tr><td class="text-muted" style="width:220px;">Име</td><td>@Model.Form.FullName</td></tr>
                        <tr><td class="text-muted">Телефон</td><td>@Model.Form.Telephone</td></tr>
                        <tr><td class="text-muted">Адрес</td><td>@Model.Form.Address</td></tr>
                        <tr><td class="text-muted">Имейл</td><td>@Model.Form.Email</td></tr>
                        <tr><td class="text-muted">Дата на раждане</td><td>@(Model.Form.DateOfBirth?.ToString("dd.MM.yyyy") ?? "-")</td></tr>
                    </tbody>
                </table>
            </div>

            <h2 class="h5 mt-4 mb-3">Поръчка</h2>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <tbody>
                        <tr><td class="text-muted" style="width:220px;">Пакет</td><td>@(Model.Form.Bundle != null ? $"{Model.Form.Bundle.Name} ({Model.Form.Bundle.Size} бр.)" : "-")</td></tr>
                        <tr><td class="text-muted">Крайна цена</td><td>@Model.Form.TotalPrice.ToString("0.00") лв</td></tr>
                        <tr><td class="text-muted">Промо код</td><td>@(string.IsNullOrWhiteSpace(Model.Form.PromoCode) ? "-" : Model.Form.PromoCode)</td></tr>
                        <tr><td class="text-muted">Създадена</td><td>@Model.Form.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr>
                        <tr><td class="text-muted">Обновена</td><td>@(Model.Form.UpdatedUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Edit card -->
    <div class="col-12 col-lg-5">
        <div class="border rounded-3 p-3 p-md-4">
            <h2 class="h5 mb-3">Редакция</h2>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Form.Id" />

                <div class="mb-3">
                    <label asp-for="Form.Status" class="form-label">Статус</label>
                    <select asp-for="Form.Status" class="form-select">
                        @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                        {
                            <option value="@((int)status)">@DisplayHelper.GetEnumDisplayName(status)</option>
                        }
                    </select>
                    <span asp-validation-for="Form.Status" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.Notes" class="form-label">Бележки</label>
                    <textarea asp-for="Form.Notes" class="form-control" rows="6" maxlength="500" placeholder="До 500 символа..."></textarea>
                    <div class="form-text">Оставащи символи: <span id="notesLeft">500</span></div>
                    <span asp-validation-for="Form.Notes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <a class="btn btn-outline-dark" asp-page="/Admin/Orders"><i class="bi bi-arrow-left"></i> Назад</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Запази</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
          const ta = document.querySelector('textarea[name="Form.Notes"]');
          const left = document.getElementById('notesLeft');
          if (!ta || !left) return;
          const max = parseInt(ta.getAttribute('maxlength') || '500', 10);
          const update = () => { left.textContent = (max - (ta.value?.length || 0)).toString(); };
          ta.addEventListener('input', update);
          update();
        })();
    </script>
}